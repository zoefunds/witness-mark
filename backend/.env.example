# Copy to .env and fill in real values. Never commit .env.

# --- Database (Fly Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/witnessmark

# --- GenLayer StudioNet ---
GENLAYER_RPC_URL=
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_NETWORK=studionet

# --- Cloudinary (evidence file storage -> stable public URL for contract web-fetch) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Upstash Redis (cache layer to stay under GenLayer's 30 req/min read limit) ---
REDIS_URL=

# --- Wallet auth ---
SESSION_JWT_SECRET=
REOWN_PROJECT_ID=

# --- Server ---
PORT=8080
NODE_ENV=production
CORS_ORIGIN=https://witnessmark.vercel.app
